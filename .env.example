# FinFlow Environment Variables Example
# Copy this file to .env and fill in your actual values

# AI Configuration
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_AI_ENABLED=true
VITE_AI_MAX_RESPONSES=4
VITE_AI_LANGUAGE=he

# Security & Authentication
FINFLOW_SECRET_TOKEN=
FINFLOW_JWT_SECRET=
VITE_APP_SECRET=

# External Integrations
ZAPIER_WEBHOOK_URL=
VITE_ANALYTICS_KEY=
EMAIL_SERVICE_KEY=

# Database & Storage
DATABASE_URL=
REDIS_URL=

# Feature Flags
VITE_FEATURE_FINANCE_FORM=true
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_ADVANCED_REPORTS=true

# Development
NODE_ENV=development
VITE_DEBUG_MODE=false
